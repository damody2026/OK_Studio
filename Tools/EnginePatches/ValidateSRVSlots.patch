+/**
+ * OpenKoikatsu diagnostic (D3D12.OK.ValidateSRVSlots, read-only cvar, default 0).
+ *
+ * The SRV state cache holds raw, non-owning FD3D12ShaderResourceView pointers and a table rebuild copies every slot
+ * in the current shader's range, while a destroyed texture never scrubs that cache. With the cvar on, every view
+ * registers itself here, and the table builder checks a slot's pointer before dereferencing it: a dead one is
+ * reported (stage, slot, pointer) and replaced by the null view instead of handing the GPU a stale descriptor.
+ *
+ * It sees "the view object is gone". It does NOT see "the view is alive but its resource is dead".
+ */
+namespace OKViewLiveness
+{
+	/** Read once, after the cvar system is up. False means every entry point below is a no-op. */
+	D3D12RHI_API bool IsEnabled();
+	D3D12RHI_API void Register(const FD3D12View* InView);
+	D3D12RHI_API void Unregister(const FD3D12View* InView);
+	D3D12RHI_API bool IsLive(const void* InView);
+	/** Logs the first time each distinct pointer is seen dead, so a hot loop cannot flood the log. */
+	D3D12RHI_API void ReportStale(uint32 InShaderStage, uint32 InSlotIndex, const void* InView);
+	/**
+	 * ARRIVAL EVIDENCE (ERROR_LOG #14: an instrument whose silence looks like a clean result is not an instrument).
+	 * Called on every checked slot; logs once on the first one and again every 4,000,000 checks, so "no stale slot
+	 * was reported" can be told apart from "the check never ran".
+	 */
+	D3D12RHI_API void NoteChecked();
+}
