@@ -374,6 +376,13 @@ namespace OKViewLiveness
 	 * was reported" can be told apart from "the check never ran".
 	 */
 	D3D12RHI_API void NoteChecked();
+	/**
+	 * The other half: the view is alive, but the resource it was created against is no longer the one its texture
