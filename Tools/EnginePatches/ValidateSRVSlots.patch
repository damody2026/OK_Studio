@@ -454,6 +454,19 @@ D3D12_GPU_DESCRIPTOR_HANDLE FD3D12DescriptorCache::BuildSRVTable(EShaderFrequenc
 
 	for (uint32 SlotIndex = 0; SlotIndex < SlotsNeeded; SlotIndex++)
 	{
+		// OpenKoikatsu diagnostic (default off): this array is raw and non-owning, and nothing scrubs it when a
+		// texture is destroyed, so a slot can still point at a freed view. Check before dereferencing.
+		if (OKViewLiveness::IsEnabled() && SRVs[SlotIndex] != nullptr)
+		{
+			OKViewLiveness::NoteChecked();
+		}
+		if (OKViewLiveness::IsEnabled() && SRVs[SlotIndex] != nullptr && !OKViewLiveness::IsLive(SRVs[SlotIndex]))
+		{
+			OKViewLiveness::ReportStale(static_cast<uint32>(ShaderStage), SlotIndex, SRVs[SlotIndex]);
+			SrcDescriptors[SlotIndex] = DefaultViews.NullSRV;
+			check(SrcDescriptors[SlotIndex].ptr != 0);
+			continue;
+		}
 		if (FD3D12ShaderResourceView* SRV = SRVs[SlotIndex])
 		{
 			SrcDescriptors[SlotIndex] = SRV->GetOfflineCpuHandle();
diff --git a/Engine/Source/Runtime/D3D12RHI/Private/D3D12View.cpp b/Engine/Source/Runtime/D3D12RHI/Private/D3D12View.cpp
index ebe968ab3f86..01033fa3f397 100644
--- a/Engine/Source/Runtime/D3D12RHI/Private/D3D12View.cpp
+++ b/Engine/Source/Runtime/D3D12RHI/Private/D3D12View.cpp
@@ -1,4 +1,4 @@
-// Copyright Epic Games, Inc. All Rights Reserved.
+﻿// Copyright Epic Games, Inc. All Rights Reserved.
 
 #include "D3D12View.h"
 #include "D3D12RHIPrivate.h"
@@ -220,6 +220,72 @@ inline bool ViewTypeSupportsBindless(ED3D12ViewType InViewType)
 }
 #endif
 
+namespace OKViewLiveness
+{
+	static TAutoConsoleVariable<int32> CVarValidateSRVSlots(
+		TEXT("D3D12.OK.ValidateSRVSlots"), 0,
+		TEXT("Check the SRV state cache's raw view pointers before a table rebuild dereferences them (diagnostic)."),
+		ECVF_ReadOnly);
+
+	static FRWLock GLock;
+	static TSet<const void*> GLiveViews;
+	static TSet<const void*> GReported;
+
+	bool IsEnabled()
+	{
+		static int32 Cached = -1;
+		if (Cached < 0)
+		{
+			Cached = CVarValidateSRVSlots.GetValueOnAnyThread() != 0 ? 1 : 0;
+		}
+		return Cached == 1;
+	}
+
+	void Register(const FD3D12View* InView)
+	{
+		FWriteScopeLock Lock(GLock);
+		GLiveViews.Add(InView);
+	}
+
+	void Unregister(const FD3D12View* InView)
+	{
+		FWriteScopeLock Lock(GLock);
+		GLiveViews.Remove(InView);
+	}
+
+	bool IsLive(const void* InView)
+	{
+		FReadScopeLock Lock(GLock);
+		return GLiveViews.Contains(InView);
+	}
+
+	static FThreadSafeCounter64 GChecked;
+
+	void NoteChecked()
+	{
+		const int64 Count = GChecked.Increment();
+		if (Count == 1 || (Count % 4000000) == 0)
+		{
+			UE_LOG(LogD3D12RHI, Display, TEXT("OK SRV slot validation active: %lld slots checked so far, %d views live"),
+				Count, GLiveViews.Num());
+		}
+	}
+
+	void ReportStale(uint32 InShaderStage, uint32 InSlotIndex, const void* InView)
+	{
+		{
+			FWriteScopeLock Lock(GLock);
+			if (GReported.Contains(InView))
+			{
+				return;
+			}
+			GReported.Add(InView);
+		}
+		UE_LOG(LogD3D12RHI, Warning, TEXT("OK stale SRV slot: stage=%u slot=%u view=%p was destroyed and is still in the state cache; substituting the null view"),
+			InShaderStage, InSlotIndex, InView);
+	}
+}
