+++ b/Engine/Source/Runtime/D3D12RHI/Private/D3D12View.cpp
@@ -271,6 +271,42 @@ namespace OKViewLiveness
 		}
 	}
 
+	static TSet<const void*> GReportedResource;
+
+	void CheckResourceCurrent(uint32 InShaderStage, uint32 InSlotIndex, const FD3D12ShaderResourceView* InView)
+	{
+		if (InView == nullptr)
+		{
+			return;
+		}
+		// No IsInitialized() guard: it is protected, and it is not needed here. A view only reaches a state cache
+		// slot through FD3D12StateCache::SetShaderResourceView, which itself calls SRV->GetResource() on the way in
+		// (D3D12StateCache.cpp:1573 and :1586), so a view sitting in a slot has necessarily been created.
+		FD3D12BaseShaderResource* Base = InView->GetShaderResource();
+		if (Base == nullptr)
+		{
+			// A location-only view (no owning shader resource): nothing to compare it against.
+			return;
+		}
+		const FD3D12Resource* Recorded = InView->GetResource();
+		const FD3D12Resource* Current = Base->GetResource();
+		const bool bLocationValid = Base->ResourceLocation.IsValid();
+		if (bLocationValid && Recorded == Current)
+		{
+			return;
+		}
+		{
+			FWriteScopeLock Lock(GLock);
+			if (GReportedResource.Contains(InView))
+			{
+				return;
+			}
+			GReportedResource.Add(InView);
+		}
+		UE_LOG(LogD3D12RHI, Warning, TEXT("OK stale SRV resource: stage=%u slot=%u view=%p recorded=%p current=%p locationValid=%d"),
+			InShaderStage, InSlotIndex, InView, Recorded, Current, bLocationValid ? 1 : 0);
+	}
+
 	void ReportStale(uint32 InShaderStage, uint32 InSlotIndex, const void* InView)
 	{
 		{
