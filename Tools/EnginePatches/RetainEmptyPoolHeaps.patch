diff --git a/Engine/Source/Runtime/D3D12RHI/Private/D3D12PoolAllocator.cpp b/Engine/Source/Runtime/D3D12RHI/Private/D3D12PoolAllocator.cpp
index 5cba28ee675b..3cf5bd6d2322 100644
--- a/Engine/Source/Runtime/D3D12RHI/Private/D3D12PoolAllocator.cpp
+++ b/Engine/Source/Runtime/D3D12RHI/Private/D3D12PoolAllocator.cpp
@@ -4,6 +4,15 @@
 #include "D3D12RHIPrivate.h"
 #include "HAL/LowLevelMemTracker.h"
 
+// OK: a GPU read through a stale descriptor into a freed placed resource is harmless while its heap is still mapped, and
+// a device-removing page fault once the empty heap has been handed back (card reader PageFault, 2026-11-20). Keeping
+// empty pools also lets the next allocations reuse them instead of creating new heaps.
+static TAutoConsoleVariable<int32> CVarOKRetainEmptyPoolMB(
+	TEXT("D3D12.OK.RetainEmptyPoolMB"),
+	0,
+	TEXT("Megabytes of empty D3D12 pool heaps each pool allocator keeps mapped instead of releasing (0 = engine default: release empty pools after 20 frames)."),
+	ECVF_Default);
+
 LLM_DECLARE_TAG(D3D12AllocatorUnused);
 
 //-----------------------------------------------------------------------------
@@ -844,11 +853,20 @@ void FD3D12PoolAllocator::CleanUpAllocations(uint64 InFrameLag, bool bForceFree)
 
 	// Trim empty allocators if not used in last n frames
 	const uint64 CompletedFence = FrameFence.GetCompletedFenceValue(/* bUpdateCachedFenceValue */ true);
+	// OK: keep up to D3D12.OK.RetainEmptyPoolMB of empty pools mapped (per allocator) instead of handing them back.
+	// Only the periodic trim (InFrameLag > 0) retains; a forced free and the allocator's own teardown (lag 0) still free all.
+	const int64 RetainBudget = (!bForceFree && InFrameLag > 0) ? int64(FMath::Max(0, CVarOKRetainEmptyPoolMB.GetValueOnAnyThread())) * 1024 * 1024 : 0;
+	int64 RetainedEmpty = 0;
 	for (int32 PoolIndex = 0; PoolIndex < Pools.Num(); ++PoolIndex)
 	{
 		FD3D12MemoryPool* MemoryPool = (FD3D12MemoryPool*) Pools[PoolIndex];
 		if (MemoryPool != nullptr && MemoryPool->IsEmpty() && (bForceFree || (MemoryPool->GetLastUsedFrameFence() + InFrameLag <= CompletedFence)))
 		{
+			if (RetainedEmpty + int64(MemoryPool->GetPoolSize()) <= RetainBudget)
+			{
+				RetainedEmpty += int64(MemoryPool->GetPoolSize());
+				continue;
+			}
 #if PLATFORM_WINDOWS
 			LLM_SCOPED_PAUSE_TRACKING_WITH_ENUM_AND_AMOUNT_BYTAG(D3D12AllocatorUnused, 0 - int64(MemoryPool->GetPoolSize()), ELLMTracker::Platform, ELLMAllocType::System);
 #endif
