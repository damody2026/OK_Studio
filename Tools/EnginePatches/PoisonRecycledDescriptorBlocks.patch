 .../D3D12RHI/Private/D3D12Descriptors.h       |  9 +++-
 2 files changed, 61 insertions(+), 2 deletions(-)

diff --git a/Engine/Source/Runtime/D3D12RHI/Private/D3D12Descriptors.cpp b/Engine/Source/Runtime/D3D12RHI/Private/D3D12Descriptors.cpp
index 1806fe460a66..409b1ca42261 100644
--- a/Engine/Source/Runtime/D3D12RHI/Private/D3D12Descriptors.cpp
+++ b/Engine/Source/Runtime/D3D12RHI/Private/D3D12Descriptors.cpp
@@ -1,4 +1,4 @@
-// Copyright Epic Games, Inc. All Rights Reserved.
+﻿// Copyright Epic Games, Inc. All Rights Reserved.
 
 #include "D3D12Descriptors.h"
 #include "D3D12RHIPrivate.h"
@@ -311,9 +311,61 @@ void FD3D12OnlineDescriptorManager::FreeHeapBlock(FD3D12OnlineDescriptorBlock* I
 	FD3D12DynamicRHI::GetD3DRHI()->DeferredDelete(InHeapBlock, this);
 }
 
+static TAutoConsoleVariable<int32> CVarOKPoisonRecycledDescriptorBlocks(
+	TEXT("D3D12.OK.PoisonRecycledDescriptorBlocks"), 0,
+	TEXT("Fill an online descriptor heap block with null descriptors as it is recycled (diagnostic)."),
+	ECVF_ReadOnly);
+
+static bool OKPoisonEnabled()
+{
+	static int32 Cached = -1;
+	if (Cached < 0)
+	{
+		Cached = CVarOKPoisonRecycledDescriptorBlocks.GetValueOnAnyThread() != 0 ? 1 : 0;
+	}
+	return Cached == 1;
+}
+
+static FThreadSafeCounter64 GOKPoisonedBlocks;
+
+void FD3D12OnlineDescriptorManager::PoisonBlock(FD3D12OnlineDescriptorBlock* Block)
+{
+	if (Block == nullptr || Block->Size == 0)
+	{
+		return;
+	}
+	ID3D12Device* Device = GetParentDevice()->GetDevice();
+	const D3D12_CPU_DESCRIPTOR_HANDLE NullSRV = GetParentDevice()->GetDefaultViews().NullSRV;
+	for (ERHIPipeline Pipeline : MakeFlagsRange(ERHIPipeline::All))
+	{
+		FD3D12DescriptorHeap* Heap = Heaps[Pipeline].GetReference();
+		if (Heap == nullptr)
+		{
+			continue;
+		}
+		for (uint32 Slot = 0; Slot < Block->Size; ++Slot)
+		{
+			const D3D12_CPU_DESCRIPTOR_HANDLE Dest = Heap->GetCPUSlotHandle(Block->BaseSlot + Slot);
+			Device->CopyDescriptorsSimple(1, Dest, NullSRV, D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+		}
+	}
+	const int64 Count = GOKPoisonedBlocks.Increment();
+	if (Count == 1 || (Count % 256) == 0)
+	{
+		UE_LOG(LogD3D12RHI, Display, TEXT("OK poisoned recycled descriptor block: count=%lld baseSlot=%u size=%u"),
+			Count, Block->BaseSlot, Block->Size);
+	}
+}
+
 // Called by the EOP task to recycle blocks
 void FD3D12OnlineDescriptorManager::Recycle(FD3D12OnlineDescriptorBlock* Block)
 {
+	if (OKPoisonEnabled())
+	{
+		// Before it can be handed to anyone else: see the comment on PoisonBlock.
+		PoisonBlock(Block);
+	}
+
 	FScopeLock Lock(&CriticalSection);
 
 	// Update stats
diff --git a/Engine/Source/Runtime/D3D12RHI/Private/D3D12Descriptors.h b/Engine/Source/Runtime/D3D12RHI/Private/D3D12Descriptors.h
index 8a97d581a1f4..b60e4057d44a 100644
--- a/Engine/Source/Runtime/D3D12RHI/Private/D3D12Descriptors.h
+++ b/Engine/Source/Runtime/D3D12RHI/Private/D3D12Descriptors.h
@@ -1,4 +1,4 @@
-// Copyright Epic Games, Inc. All Rights Reserved.
+﻿// Copyright Epic Games, Inc. All Rights Reserved.
 
 #pragma once
 
@@ -235,6 +235,13 @@ public:
 	// Called by the EOP task to recycle blocks
 	void Recycle(FD3D12OnlineDescriptorBlock* Block);
 
+	/**
+	 * OpenKoikatsu diagnostic (D3D12.OK.PoisonRecycledDescriptorBlocks, read-only cvar, default 0): fill a block
+	 * with the null SRV descriptor as it is recycled. A correct fence makes this invisible; an incorrect one turns a
+	 * dangling descriptor the GPU is still reading into a null descriptor. See Docs/CARD_READER_DREAMGUI.md.
+	 */
+	void PoisonBlock(FD3D12OnlineDescriptorBlock* Block);
+
 private:
 	TRHIPipelineArray<FD3D12DescriptorHeapPtr> Heaps;
 
