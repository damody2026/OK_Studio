{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "0.1",
  "FriendlyName": "OK Mod DreamGUI panels",
  "Description": "The parent class of a mod's .dui panels (Docs/OK_MOD_FRAMEWORK_PLAN.md §6.13 D2) and the check that a mod widget is only what the DreamGUI compiler made from its .dui. Small on purpose: the ModKit cook host enables it with DreamGUI alone.",
  "Category": "OpenKoikatsu",
  "EnabledByDefault": false,
  "CanContainContent": false,
  "SupportedTargetPlatforms": [ "Win64" ],
  "Plugins": [
    { "Name": "DreamGUI", "Enabled": true }
  ],
  "Modules": [
    { "Name": "OKModDream", "Type": "Runtime", "LoadingPhase": "Default" }
  ]
}
