// Her garments pushed out over her skin and moved with her thighs' jiggle, on the GPU (ok.ClothGpu 2): the same steps as
// the CPU route (Rust belly_bulge/cover.rs CoverField::cover, then thigh_jiggle::follow_own), one garment at a time, over
// its source vertices. Field: this frame's skin of her (Rust cover.rs gpu_field, cloth_gpu.rs field), Garment: the
// garment's neighbours, triangles and maps (gpu_garment). Output: each source vertex's move (native metres, after the
// post-skin correction), added by RuntimeDeform.usf where the CPU route adds it.
#include "/Plugin/KKCrowdGpuPacking/RuntimeDeformCommon.ush"

struct FSource {float4 Position,Normal,Tangent,Weights;uint4 Bones;};
StructuredBuffer<FSource> Sources;
StructuredBuffer<float4> PaletteRows;
uint PaletteCount;
uint FallbackSlot;
uint HasPostSkinCorrection;
float4 PostSkinRow0;
float4 PostSkinRow1;
float4 PostSkinRow2;

ByteAddressBuffer Field;
ByteAddressBuffer Garment;
uint VertexCount;
uint TriangleCount;
uint Round; // ring / flip round (0..5)
uint Step;  // which step MainCS runs (OKClothCoverGpu.cpp EStep)

RWStructuredBuffer<float4> Pos;      // skinned, native
RWStructuredBuffer<float4> Follow;   // follows' move (xyz), mapped (w)
RWStructuredBuffer<float> Rise;
RWStructuredBuffer<float> RiseWas;
RWStructuredBuffer<float4> Push;
RWStructuredBuffer<float4> PushWas;
RWStructuredBuffer<uint> Taken;      // ring membership, double-buffered: [0..n) this round's, [n..2n) the next
RWStructuredBuffer<uint> Counts;     // flip halvings this round
RWStructuredBuffer<uint> Changed;    // halved last round
RWStructuredBuffer<uint> TriFlag;    // clear candidates / flip set
RWStructuredBuffer<uint> Flags;      // [0] any follow, [1] any rise, [2] any push, [3] any flip this round, [4] Hits taken, [5] Hits full
RWStructuredBuffer<uint> TriHits;    // clear: samples inside each candidate triangle
RWStructuredBuffer<uint> TriStart;   // clear: where they start in Hits
RWStructuredBuffer<float4> Hits;     // clear: corner weights (xyz), the height to reach (w)
uint HitCapacity;
RWStructuredBuffer<float4> Moves;    // the result: per source vertex

// ---- words
uint FW(uint I){return Field.Load(I*4);}
float FF(uint I){return asfloat(Field.Load(I*4));}
int FI(uint I){return asint(Field.Load(I*4));}
uint GW(uint I){return Garment.Load(I*4);}
float GF(uint I){return asfloat(Garment.Load(I*4));}
float3 F3(uint I){return float3(FF(I),FF(I+1),FF(I+2));}
// Outer field header (cloth_gpu.rs): [0] cover base or ~0, [1] jiggle slots, [2] jiggle offset, [4..13) the constants.
uint CoverBase(){return FW(0);}
bool HasCover(){return CoverBase()!=0xFFFFFFFFu;}
float FOLLOW_M(){return FF(4);} float REACH_M(){return FF(5);} float BUST_REACH_M(){return FF(6);} float NEAR_M(){return FF(7);}
float FULL_M(){return FF(8);} float LIFT_REACH_M(){return FF(9);} float FAR_M(){return FF(10);} float UNDER_M(){return FF(11);} float HUG_M(){return FF(12);}
// Cover header word K (offsets in it are from the cover base).
uint CH(uint K){return FW(CoverBase()+K);}
uint CA(uint K){return CoverBase()+CH(K);}
float Keep(){return GF(1);}

// ---- skinning (RuntimeDeform.usf EvaluateDeform's position, before the UE conversion)
float3 Transform(uint Bone,float3 V,float W){uint I=Bone*3;float4 P=float4(V,W);return float3(dot(PaletteRows[I],P),dot(PaletteRows[I+1],P),dot(PaletteRows[I+2],P));}
float3 PostTransform(float3 V,float W){float4 P=float4(V,W);return float3(dot(PostSkinRow0,P),dot(PostSkinRow1,P),dot(PostSkinRow2,P));}
void SkinK(uint3 Id){
 if(Id.x>=VertexCount)return;FSource S=Sources[Id.x];
 float3 P=0;float Total=0;
 [unroll]for(uint K=0;K<4;++K){float W=S.Weights[K];uint B=S.Bones[K];if(abs(W)<1.e-6||B>=PaletteCount)continue;P+=Transform(B,S.Position.xyz,1)*W;Total+=W;}
 if(Total>1.e-5)P/=Total;else P=Transform(FallbackSlot,S.Position.xyz,1);
 if(HasPostSkinCorrection!=0)P=PostTransform(P,1);
 Pos[Id.x]=float4(P,0);
 Follow[Id.x]=0;Rise[Id.x]=0;Push[Id.x]=0;Moves[Id.x]=0;Taken[Id.x]=0;Taken[VertexCount+Id.x]=0;Counts[Id.x]=0;Changed[Id.x]=0;
 if(Id.x<8)Flags[Id.x]=0;
}

// ---- pieces of cover.rs
float Over(float Keep_,float G){return G>=Keep_?G:Keep_*exp((G-Keep_)/Keep_);}
float PushBy(float Keep_,float G,float Lift){Lift=max(Lift,0.);float Hug=max(1.-max(G-HUG_M(),0.)/(Lift+HUG_M()),0.);return Lift*Hug+Over(Keep_,G)-G;}
uint NbrStart(uint J){return GW(GW(2)+J);} uint NbrEnd(uint J){return GW(GW(2)+J+1);} uint Nbr(uint E){return GW(GW(3)+E);}

// follows: the cloth hugging her skin moves as far as the skin under it swelled (cover.rs follows).
void FollowK(uint3 Id){
 uint J=Id.x;if(J>=VertexCount)return;
 uint M=GW(7)+J*9;
 if(!(GF(M+4)>0.)){Follow[J]=float4(0,0,0,0);return;}
 float Gap=GF(M+8);float Hug=clamp(1.-max(Gap-HUG_M(),0.)/(FOLLOW_M()-HUG_M()),0.,1.);
 float3 V=0;
 for(uint K=0;K<4;++K){float W=GF(M+4+K);if(W<=0.)break;uint I=GW(M+K);uint A=CA(13)+I*4;if(I<CH(12)&&FW(A+3)!=0)V+=F3(A)*W*Hug;}
 Follow[J]=float4(V,1);
 if(dot(V,V)>0.)InterlockedOr(Flags[0],1u);
}
// Where the cloth is for the lift: posed plus its follow (when any cloth followed).
float3 At(uint J){float3 P=Pos[J].xyz;if(Flags[0]!=0)P+=Follow[J].xyz;return P;}
bool Held(uint J){return Flags[0]!=0&&Follow[J].w>0.;}

// ---- Lift (cover.rs Lift)
float3 Way(){return float3(FF(CoverBase()+16),FF(CoverBase()+17),FF(CoverBase()+18));}
float3 Side0(){return float3(FF(CoverBase()+19),FF(CoverBase()+20),FF(CoverBase()+21));}
float3 Side1(){return float3(FF(CoverBase()+22),FF(CoverBase()+23),FF(CoverBase()+24));}
float3 Belly(){return float3(FF(CoverBase()+25),FF(CoverBase()+26),FF(CoverBase()+27));}
int2 Lo2(){return int2(FI(CoverBase()+28),FI(CoverBase()+29));} int2 Hi2(){return int2(FI(CoverBase()+30),FI(CoverBase()+31));}
bool Far(float2 Q,float Up){float3 B=Belly();return Up<B.x*Q.x+B.y*Q.y+B.z-FAR_M();}
uint Cell2(int I,int J){int2 L=Lo2(),H=Hi2();uint Hh=uint(H.y-L.y+1);return uint(I-L.x)*Hh+uint(J-L.y);}
void LiftSkin(uint I,out float2 S,out float Top,out float Base){uint A=CA(15)+I*4;S=float2(FF(A),FF(A+1));Top=FF(A+2);Base=FF(A+3);}
float RiseAt(float Keep_,float3 C){
 if(abs(C.x)>1.e6)return 0.;
 float2 Q=float2(dot(C,Side0()),dot(C,Side1()));int2 K=int2(floor(Q/LIFT_REACH_M()));int2 L=Lo2(),H=Hi2();
 if(K.x<L.x||K.x>H.x||K.y<L.y||K.y>H.y)return 0.;
 float Up=dot(C,Way());float Best=0.;if(Far(Q,Up))return 0.;
 uint Cell=Cell2(K.x,K.y);uint S0=FW(CA(32)+Cell),S1=FW(CA(32)+Cell+1);
 for(uint E=S0;E<S1;++E){uint I=FW(CA(33)+E);float2 S;float Top,Base;LiftSkin(I,S,Top,Base);
  float Room=PushBy(Keep_,Up-Base,Top-Base);if(Room<=Best)continue;
  float2 X=Q-S;float D2=X.x*X.x+X.y*X.y;if(D2>=LIFT_REACH_M()*LIFT_REACH_M())continue;float Across=sqrt(D2);
  float T=min((LIFT_REACH_M()-Across)/(LIFT_REACH_M()-FULL_M()),1.);Best=max(Best,Room*T*T*(3.-2.*T));}
 return Best;
}
void RiseK(uint3 Id){uint J=Id.x;if(J>=VertexCount)return;Rise[J]=Held(J)?0.:RiseAt(Keep(),At(J));}
// The cloth as the lift sees it: across, across, up (None: far side / unposed).
bool Seen(uint J,out float3 V){float3 C=At(J);V=0;if(abs(C.x)>1.e6)return false;float2 Q=float2(dot(C,Side0()),dot(C,Side1()));float Up=dot(C,Way());if(Far(Q,Up))return false;V=float3(Q,Up);return true;}
// Triangles clear may touch (the ones it does not skip at once); clear itself goes through them in order.
void ClearCandidatesK(uint3 Id){
 uint T=Id.x;if(T>=TriangleCount)return;uint B=GW(5)+T*3;uint K0=GW(B),K1=GW(B+1),K2=GW(B+2);TriFlag[T]=0;
 if(K0>=VertexCount||K1>=VertexCount||K2>=VertexCount)return;
 float3 A,Bv,C;if(!Seen(K0,A)||!Seen(K1,Bv)||!Seen(K2,C))return;
 float2 Lo=float2(Lo2())*LIFT_REACH_M(),Hi=float2(Hi2()+1)*LIFT_REACH_M();
 float X0=min(min(A.x,Bv.x),C.x),X1=max(max(A.x,Bv.x),C.x),Y0=min(min(A.y,Bv.y),C.y),Y1=max(max(A.y,Bv.y),C.y);
 if(X1<Lo.x||X0>Hi.x||Y1<Lo.y||Y0>Hi.y)return;
 float D=(Bv.x-A.x)*(C.y-A.y)-(C.x-A.x)*(Bv.y-A.y);if(abs(D)<1.e-10)return;
 TriFlag[T]=1;
}
// A candidate triangle's skin samples inside it, in the order clear meets them (cells, then entries): the corners' weights
// and the height the cloth must reach there (none of it reads the rise). Write: stored from Start (Hits), else counted.
uint ClearHitsOf(uint T,bool Write,uint Start){
 float Keep_=Keep();int2 L=Lo2(),H=Hi2();uint B=GW(5)+T*3;uint K[3]={GW(B),GW(B+1),GW(B+2)};
 float3 A,Bv,C;Seen(K[0],A);Seen(K[1],Bv);Seen(K[2],C);
 float X0=min(min(A.x,Bv.x),C.x),X1=max(max(A.x,Bv.x),C.x),Y0=min(min(A.y,Bv.y),C.y),Y1=max(max(A.y,Bv.y),C.y);
 float D=(Bv.x-A.x)*(C.y-A.y)-(C.x-A.x)*(Bv.y-A.y);
 int I0=clamp(int(floor(X0/LIFT_REACH_M())),L.x,H.x),I1=clamp(int(floor(X1/LIFT_REACH_M())),L.x,H.x);
 int J0=clamp(int(floor(Y0/LIFT_REACH_M())),L.y,H.y),J1=clamp(int(floor(Y1/LIFT_REACH_M())),L.y,H.y);
 uint Count=0;
 for(int I=I0;I<=I1;++I)for(int J=J0;J<=J1;++J){
  uint Cell=Cell2(I,J);uint S0=FW(CA(32)+Cell),S1=FW(CA(32)+Cell+1);
  for(uint E=S0;E<S1;++E){uint N=FW(CA(33)+E);float2 S;float Top,Base;LiftSkin(N,S,Top,Base);
   if(S.x<X0||S.x>X1||S.y<Y0||S.y>Y1)continue;
   float U=((S.x-A.x)*(C.y-A.y)-(C.x-A.x)*(S.y-A.y))/D;float V=((Bv.x-A.x)*(S.y-A.y)-(S.x-A.x)*(Bv.y-A.y))/D;
   if(U<0.||V<0.||U+V>1.)continue;
   if(Write){float3 W=float3(1.-U-V,U,V);float Z0=A.z*W.x+Bv.z*W.y+C.z*W.z;Hits[Start+Count]=float4(W,Z0+PushBy(Keep_,Z0-Base,Top-Base));}
   ++Count;
  }
 }
 return Count;
}
// Every candidate in parallel: its samples (above), in a block of Hits it takes; too many for Hits: clear goes the long way.
void ClearHitsK(uint3 Id){
 uint T=Id.x;if(T>=TriangleCount)return;TriHits[T]=0;if(TriFlag[T]==0)return;
 uint Count=ClearHitsOf(T,false,0);if(Count==0)return;
 uint Start;InterlockedAdd(Flags[4],Count,Start);
 if(Start+Count>HitCapacity){InterlockedOr(Flags[5],1u);return;}
 ClearHitsOf(T,true,Start);TriStart[T]=Start;TriHits[T]=Count;
}
void ClearLongK();
// Clear (cover.rs Lift::clear): each triangle in order reads the rise the ones before it raised. One group of 64:
//  - every 512 triangles, the ones with samples (ClearHitsK) are listed in order (each thread counts 8 of them);
//  - 64 of the list at a time: each thread reads its triangle's corners and their heights, and which of the ones before it
//    share a corner with it; then rounds: a triangle whose earlier corner-sharers are all done runs its samples (in order).
//    The ones running in a round share no corner, so every corner sees the same additions in the same order as one thread
//    going through them all (the arithmetic is the same), only the triangles that touch nothing in common run side by side.
#define CLEAR_SPAN 8u
groupshared uint GClearList[64*CLEAR_SPAN];
groupshared uint GClearOff[65];
groupshared uint GClearK[192];
groupshared float GClearZ[192];
groupshared uint GClearCount[64];
groupshared uint GClearStart[64];
groupshared uint GClearDone[2];
void ClearRun(uint Slot){
 uint K0=GClearK[Slot*3],K1=GClearK[Slot*3+1],K2=GClearK[Slot*3+2];float Az=GClearZ[Slot*3],Bz=GClearZ[Slot*3+1],Cz=GClearZ[Slot*3+2];
 uint Start=GClearStart[Slot],Count=GClearCount[Slot];
 for(uint E=0;E<Count;++E){float4 Hh=Hits[Start+E];
  float Z=(Az+Rise[K0])*Hh.x+(Bz+Rise[K1])*Hh.y+(Cz+Rise[K2])*Hh.z;
  float Short=Hh.w-Z;
  if(Short>0.){Rise[K0]+=Short;Rise[K1]+=Short;Rise[K2]+=Short;}
 }
}
void ClearK(uint3 Id){
 uint Lane=Id.x;
 if(Flags[5]!=0){if(Lane==0)ClearLongK();return;}
 for(uint Base0=0;Base0<TriangleCount;Base0+=64*CLEAR_SPAN){
  // The listed triangles, in order.
  uint First=Base0+Lane*CLEAR_SPAN;uint Mine=0;
  for(uint I=0;I<CLEAR_SPAN;++I){uint T=First+I;if(T<TriangleCount&&TriHits[T]!=0)++Mine;}
  GClearOff[Lane+1]=Mine;if(Lane==0)GClearOff[0]=0;
  GroupMemoryBarrierWithGroupSync();
  if(Lane==0)for(uint I=1;I<=64;++I)GClearOff[I]+=GClearOff[I-1];
  GroupMemoryBarrierWithGroupSync();
  const uint Total=GClearOff[64];
  if(Total!=0){
   uint At=GClearOff[Lane];
   for(uint I=0;I<CLEAR_SPAN;++I){uint T=First+I;if(T<TriangleCount&&TriHits[T]!=0)GClearList[At++]=T;}
   GroupMemoryBarrierWithGroupSync();
   for(uint C0=0;C0<Total;C0+=64){
    const uint N=min(64u,Total-C0);const bool Has=Lane<N;
    if(Has){uint T=GClearList[C0+Lane];uint B=GW(5)+T*3;uint K0=GW(B),K1=GW(B+1),K2=GW(B+2);
     float3 A,Bv,C;Seen(K0,A);Seen(K1,Bv);Seen(K2,C);
     GClearK[Lane*3]=K0;GClearK[Lane*3+1]=K1;GClearK[Lane*3+2]=K2;GClearZ[Lane*3]=A.z;GClearZ[Lane*3+1]=Bv.z;GClearZ[Lane*3+2]=C.z;
     GClearCount[Lane]=TriHits[T];GClearStart[Lane]=TriStart[T];}
    if(Lane==0){GClearDone[0]=0;GClearDone[1]=0;}
    GroupMemoryBarrierWithGroupSync();
    // The earlier ones in this chunk sharing a corner.
    uint D0=0,D1=0;
    if(Has){uint K0=GClearK[Lane*3],K1=GClearK[Lane*3+1],K2=GClearK[Lane*3+2];
     for(uint J=0;J<Lane;++J){uint J0=GClearK[J*3],J1=GClearK[J*3+1],J2=GClearK[J*3+2];
      bool S=K0==J0||K0==J1||K0==J2||K1==J0||K1==J1||K1==J2||K2==J0||K2==J1||K2==J2;
      if(S){if(J<32)D0|=1u<<J;else D1|=1u<<(J-32);}}}
    const uint Full0=N>=32?0xFFFFFFFFu:((1u<<N)-1u);const uint Full1=N<=32?0u:(N==64?0xFFFFFFFFu:((1u<<(N-32))-1u));
    const uint Bit0=Lane<32?(1u<<Lane):0u,Bit1=Lane>=32?(1u<<(Lane-32)):0u;
    bool Done=!Has;
    [loop]for(;;){
     AllMemoryBarrierWithGroupSync();
     const uint Dn0=GClearDone[0],Dn1=GClearDone[1];
     if(Dn0==Full0&&Dn1==Full1)break;
     const bool Ready=!Done&&(D0&~Dn0)==0&&(D1&~Dn1)==0;
     if(Ready){ClearRun(Lane);Done=true;}
     AllMemoryBarrierWithGroupSync();
     if(Ready){InterlockedOr(GClearDone[0],Bit0);InterlockedOr(GClearDone[1],Bit1);}
    }
    GroupMemoryBarrierWithGroupSync();
   }
  }
  GroupMemoryBarrierWithGroupSync();
 }
}
// One thread, everything in order (more samples than Hits holds).
void ClearLongK(){
 float Keep_=Keep();int2 L=Lo2(),H=Hi2();
 for(uint T=0;T<TriangleCount;++T){
  if(TriFlag[T]==0)continue;uint B=GW(5)+T*3;uint K[3]={GW(B),GW(B+1),GW(B+2)};
  float3 A,Bv,C;Seen(K[0],A);Seen(K[1],Bv);Seen(K[2],C);
  float X0=min(min(A.x,Bv.x),C.x),X1=max(max(A.x,Bv.x),C.x),Y0=min(min(A.y,Bv.y),C.y),Y1=max(max(A.y,Bv.y),C.y);
  float D=(Bv.x-A.x)*(C.y-A.y)-(C.x-A.x)*(Bv.y-A.y);
  int I0=clamp(int(floor(X0/LIFT_REACH_M())),L.x,H.x),I1=clamp(int(floor(X1/LIFT_REACH_M())),L.x,H.x);
  int J0=clamp(int(floor(Y0/LIFT_REACH_M())),L.y,H.y),J1=clamp(int(floor(Y1/LIFT_REACH_M())),L.y,H.y);
  for(int I=I0;I<=I1;++I)for(int J=J0;J<=J1;++J){
   uint Cell=Cell2(I,J);uint S0=FW(CA(32)+Cell),S1=FW(CA(32)+Cell+1);
   for(uint E=S0;E<S1;++E){uint N=FW(CA(33)+E);float2 S;float Top,Base;LiftSkin(N,S,Top,Base);
    if(S.x<X0||S.x>X1||S.y<Y0||S.y>Y1)continue;
    float U=((S.x-A.x)*(C.y-A.y)-(C.x-A.x)*(S.y-A.y))/D;float V=((Bv.x-A.x)*(S.y-A.y)-(S.x-A.x)*(Bv.y-A.y))/D;
    if(U<0.||V<0.||U+V>1.)continue;
    float3 W=float3(1.-U-V,U,V);
    float Z=(A.z+Rise[K[0]])*W.x+(Bv.z+Rise[K[1]])*W.y+(C.z+Rise[K[2]])*W.z;
    float Z0=A.z*W.x+Bv.z*W.y+C.z*W.z;
    float Short=Z0+PushBy(Keep_,Z0-Base,Top-Base)-Z;
    if(Short>0.){Rise[K[0]]+=Short;Rise[K[1]]+=Short;Rise[K[2]]+=Short;}
   }
  }
 }
}
void RiseHeldK(uint3 Id){uint J=Id.x;if(J>=VertexCount)return;if(Held(J))Rise[J]=0.;uint T=Rise[J]>0.?1u:0u;Taken[J]=T;if(T!=0)InterlockedOr(Flags[1],1u);}
// A ring round the cloth already taken (both rings: grown by one each round, cover.rs).
void GrowK(uint3 Id){
 uint J=Id.x;if(J>=VertexCount)return;uint In=Taken[J];
 if(In==0)for(uint E=NbrStart(J);E<NbrEnd(J);++E)if(Taken[Nbr(E)]!=0){In=1;break;}
 Taken[VertexCount+J]=In;RiseWas[J]=Rise[J];PushWas[J]=Push[J];
}
// The ring rounds in one pass each: the ring grows (GrowK) and averages last round's values. Round r reads the even
// buffers (Rise, Push, Taken[0..n)) when r is even, writes the odd ones (RiseWas, PushWas, Taken[n..2n)), and the other way
// round: after six rounds the result is back in Rise / Push / Taken[0..n). The same sums as GrowK + the ring step.
bool TakenIn(uint J){return Taken[(Round&1)*VertexCount+J]!=0;}
bool GrownIn(uint J){if(TakenIn(J))return true;for(uint E=NbrStart(J);E<NbrEnd(J);++E)if(TakenIn(Nbr(E)))return true;return false;}
float RiseIn(uint J){return (Round&1)==0?Rise[J]:RiseWas[J];}
float3 PushIn(uint J){return (Round&1)==0?Push[J].xyz:PushWas[J].xyz;}
void RiseRingK(uint3 Id){
 uint J=Id.x;if(J>=VertexCount)return;const bool In=GrownIn(J);Taken[((Round+1)&1)*VertexCount+J]=In?1u:0u;
 float V=RiseIn(J);uint S0=NbrStart(J),S1=NbrEnd(J);
 if(In&&S0!=S1){float Sum=0.;for(uint E=S0;E<S1;++E)Sum+=RiseIn(Nbr(E));float Avg=Sum*0.8/float(S1-S0);if(Avg>V&&!Held(J))V=Avg;}
 if((Round&1)==0)RiseWas[J]=V;else Rise[J]=V;
}
// The cloth as it is when her breasts push it: posed, plus the follow and the lift (when either moved any).
float3 Lifted(uint J){float3 T=0;if(Flags[0]!=0)T+=Follow[J].xyz;if(Flags[1]!=0)T+=Way()*Rise[J];return T;}
float3 Moved(uint J){return Pos[J].xyz+Lifted(J);}

// ---- push_at (cover.rs CoverField::push_at)
float3 PushAt(float Keep_,float3 C){
 int3 K=int3(floor(C/REACH_M()));int3 L=int3(FI(CoverBase()+4),FI(CoverBase()+5),FI(CoverBase()+6)),H=int3(FI(CoverBase()+7),FI(CoverBase()+8),FI(CoverBase()+9));
 if(any(K<L)||any(K>H))return 0;
 uint Hh=uint(H.y-L.y+1),Ww=uint(H.z-L.z+1);uint Cell=(uint(K.x-L.x)*Hh+uint(K.y-L.y))*Ww+uint(K.z-L.z);
 uint S0=FW(CA(10)+Cell),S1=FW(CA(10)+Cell+1);if(S0==S1)return 0;
 float Best=0.;float3 W3=0;
 for(uint E=S0;E<S1;++E){uint I=FW(CA(11)+E);uint A=CA(3)+I*10;float3 P0=F3(A),P=F3(A+3),N=F3(A+6);
  if(FW(A+9)!=0)continue;
  if(dot(C-P0,N)< -UNDER_M())continue;
  float3 G=C-P;float Hd=dot(G,N);float Across=dot(G,G)-Hd*Hd;
  if(Across>=BUST_REACH_M()*BUST_REACH_M())continue;
  float T=1.-sqrt(Across)/BUST_REACH_M();float W=T*T*(3.-2.*T);
  float Need=PushBy(Keep_,dot(C-P0,N),dot(P-P0,N))*W;
  if(Need<=0.)continue;
  Best=max(Best,Need);W3+=N*Need;}
 float Lw=sqrt(dot(W3,W3));
 return (Best>0.&&Lw>1.e-9)?float3(W3.x/Lw*Best,W3.y/Lw*Best,W3.z/Lw*Best):float3(0,0,0);
}
void PushAtK(uint3 Id){
 uint J=Id.x;if(J>=VertexCount)return;float3 V=HasCover()?PushAt(Keep(),Moved(J)):float3(0,0,0);Push[J]=float4(V,0);
 uint T=dot(V,V)>0.?1u:0u;Taken[J]=T;if(T!=0)InterlockedOr(Flags[2],1u);
}
void PushRingK(uint3 Id){
 uint J=Id.x;if(J>=VertexCount)return;const bool In=GrownIn(J);Taken[((Round+1)&1)*VertexCount+J]=In?1u:0u;
 float3 V=PushIn(J);uint S0=NbrStart(J),S1=NbrEnd(J);
 if(In&&S0!=S1){float3 S=0;for(uint E=S0;E<S1;++E)S+=PushIn(Nbr(E));
  float F=0.6/float(S1-S0);float3 Avg=float3(S.x*F,S.y*F,S.z*F);if(dot(Avg,Avg)>dot(V,V))V=Avg;}
 if((Round&1)==0)PushWas[J]=float4(V,0);else Push[J]=float4(V,0);
}
// ---- flips (cover.rs pushes_from): the triangles the pushes may turn over, then rounds of halving their corners.
float3 Cross3(float3 U,float3 V){return float3(U.y*V.z-U.z*V.y,U.z*V.x-U.x*V.z,U.x*V.y-U.y*V.x);}
bool Zero(uint K){float3 V=Push[K].xyz;return dot(V,V)==0.;}
void FlipSetK(uint3 Id){
 uint T=Id.x;if(T>=TriangleCount)return;uint B=GW(5)+T*3;uint A=GW(B),Bk=GW(B+1),C=GW(B+2);TriFlag[T]=0;
 if(A>=VertexCount||Bk>=VertexCount||C>=VertexCount)return;if(Zero(A)&&Zero(Bk)&&Zero(C))return;
 float3 W=Cross3(Moved(Bk)-Moved(A),Moved(C)-Moved(A));if(!(dot(W,W)>1.e-16))return;TriFlag[T]=1;
}
void FlipCheckK(uint3 Id){
 uint T=Id.x;if(T>=TriangleCount||TriFlag[T]==0)return;uint B=GW(5)+T*3;uint A=GW(B),Bk=GW(B+1),C=GW(B+2);
 if(Round>0&&!(Changed[A]!=0||Changed[Bk]!=0||Changed[C]!=0))return;
 if(Zero(A)&&Zero(Bk)&&Zero(C))return;
 float3 PA=Moved(A),PB=Moved(Bk),PC=Moved(C);float3 Was=Cross3(PB-PA,PC-PA);float WasLen=sqrt(dot(Was,Was));
 float3 MA=PA+Push[A].xyz,MB=PB+Push[Bk].xyz,MC=PC+Push[C].xyz;float3 Now=Cross3(MB-MA,MC-MA);
 if(dot(Was,Now)<=0.2*WasLen*sqrt(dot(Now,Now))){InterlockedAdd(Counts[A],1u);InterlockedAdd(Counts[Bk],1u);InterlockedAdd(Counts[C],1u);}
}
void FlipApplyK(uint3 Id){
 uint J=Id.x;if(J>=VertexCount)return;uint N=Counts[J];Counts[J]=0;Changed[J]=N!=0?1u:0u;
 if(N!=0){float3 V=Push[J].xyz;for(uint I=0;I<N;++I)V=float3(V.x*0.5,V.y*0.5,V.z*0.5);Push[J]=float4(V,0);}
}
// ---- the result, and the jiggle's share (thigh_jiggle.rs follow_own: four of her skin round the islands, weighed).
void ResultK(uint3 Id){
 uint J=Id.x;if(J>=VertexCount)return;
 float3 D=Lifted(J);if(Flags[2]!=0)D+=Push[J].xyz;
 if(FW(1)!=0&&GW(8)!=0){uint M=GW(9)+J*8;
  if(GF(M+4)>0.){float3 V=0;for(uint K=0;K<4;++K){float W=GF(M+4+K);if(W>0.){uint S=GW(M+K);if(S<FW(1))V+=float3(FF(FW(2)+S*4),FF(FW(2)+S*4+1),FF(FW(2)+S*4+2))*W;}}D+=V;}}
 Moves[J]=float4(D,0);
}

// One entry point: the step is a parameter (one shader type).
[numthreads(64,1,1)]
void MainCS(uint3 Id:SV_DispatchThreadID){
 switch(Step){
  case 0: SkinK(Id);break;
  case 1: FollowK(Id);break;
  case 2: RiseK(Id);break;
  case 3: ClearCandidatesK(Id);break;
  case 4: ClearK(Id);break; // one group of 64 (OKClothCoverGpu.cpp)
  case 5: RiseHeldK(Id);break;
  case 6: GrowK(Id);break;
  case 7: RiseRingK(Id);break;
  case 8: PushAtK(Id);break;
  case 9: PushRingK(Id);break;
  case 10: FlipSetK(Id);break;
  case 11: FlipCheckK(Id);break;
  case 12: FlipApplyK(Id);break;
  case 13: ResultK(Id);break;
  case 14: ClearHitsK(Id);break;
  default: break;
 }
}
