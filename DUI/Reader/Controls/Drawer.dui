// The title row of one of the right panel's drawers; pressing it folds the drawer's body (made by code, placed right
// under this row) away.
class /Game/UI/Reader/Controls/WBP_OKDrawer
use "Theme.dui" as ui

Widget Root {
    AnchorData.SizeDelta = (400, 48)
    + Overlay { }
    Native.Button Header : ui.TabOff {
        Style.Height = 44
        @slot { HorizontalAlignment = Fill  VerticalAlignment = Fill }
        Text Title : ui.Lead { Text = "" }
    }
}
